{
  "version": 2,
  "builds": [
    {
      "src": "api/analyze.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/analyze",
      "dest": "api/analyze.py"
    }
  ],
  "functions": {
    "api/analyze.py": {
      "includeFiles": "requirements.txt",
      "runtime": "python3.12"
    }
  }
}